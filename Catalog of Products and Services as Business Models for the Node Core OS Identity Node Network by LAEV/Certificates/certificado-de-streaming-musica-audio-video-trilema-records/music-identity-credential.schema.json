{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/byLAEV/Node-Core-OS/blob/main/Catalog%20of%20Products%20and%20Services%20as%20Business%20Models%20for%20the%20Node%20Core%20OS%20Identity%20Node%20Network%20by%20LAEV/Certificates/certificado-de-streaming-musica-audio-video-trilema-records/music-identity-credential.schema.json",
  "title": "Trilema Records Music Identity Credential (proposal)",
  "description": "Proposed signed claim model. This schema does not itself establish civil identity, copyright ownership, licensing, or distribution authorization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "credential_id",
    "profile",
    "issuer",
    "subject",
    "issued_at",
    "status",
    "claims"
  ],
  "properties": {
    "credential_id": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "const": "trilema-music-streaming"
    },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "key_id"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "key_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artist_id",
        "artist_name"
      ],
      "properties": {
        "artist_id": {
          "type": "string",
          "minLength": 1
        },
        "artist_name": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        }
      }
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "suspended",
        "revoked",
        "expired"
      ]
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_scope"
      ],
      "properties": {
        "identity_scope": {
          "type": "array",
          "items": {
            "enum": [
              "artist-profile",
              "catalog-administration",
              "audio-streaming",
              "video-streaming",
              "distribution-submission"
            ]
          },
          "uniqueItems": true
        },
        "rights_review_reference": {
          "type": "string"
        },
        "territories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "sha256"
        ],
        "properties": {
          "evidence_id": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "visibility": {
            "enum": [
              "public",
              "restricted",
              "private"
            ]
          }
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      }
    }
  }
}
