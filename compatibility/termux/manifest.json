{
  "profile_id": "termux-native-aarch64",
  "contract": "NCTCL-TERMUX-1",
  "platform": "android-termux",
  "architectures": [
    "aarch64"
  ],
  "status": "experimental",
  "package_manager": "pkg",
  "shells": [
    "bash"
  ],
  "node_core_runtime_layout": {
    "canonical_manifest": "installer/layout-manifest.json",
    "installed_copy": "~/.node-core/lobby/manifests/layout-manifest.json",
    "lobby_api": "GET /api/layout/manifest",
    "runtime_root": "~/.node-core",
    "installer_consumes_manifest": true,
    "updates_preserve_persistent_directories": [
      "storage",
      "ipfs"
    ]
  },
  "lobby": {
    "implementation": "python-stdlib-http-server",
    "bind": "127.0.0.1",
    "port": 8765,
    "transport_preference": [
      "https",
      "http-loopback"
    ],
    "home_screen_entry": "Termux:Widget",
    "release_package_staging": {
      "enabled": true,
      "storage": "~/.node-core/lobby/packages",
      "max_package_size_bytes": 314572800,
      "integrity": "SHA-256 against official GitHub Release asset digest",
      "extracts_archives": true,
      "executes_installers": true,
      "requires_local_session_token": true,
      "execution": {
        "canonical_scripts": {
          "install": "installer/install.sh",
          "update": "installer/update.sh"
        },
        "start_endpoint": "POST /api/packages/execute",
        "output_endpoint": "POST /api/packages/output",
        "confirmation": "explicit browser confirmation after official release SHA-256 verification",
        "latest_release_revalidation": true,
        "archive_safety": "reject absolute paths, parent traversal, symlinks and special files; enforce file-count and expanded-size limits",
        "max_expanded_bytes": 1073741824,
        "max_files": 12000,
        "max_runtime_seconds": 1800,
        "max_output_bytes": 262144,
        "arbitrary_shell_commands": false
      }
    },
    "certificate_manager": {
      "enabled": true,
      "catalog": "~/.node-core/lobby/certificates/catalog.json",
      "module": "~/.node-core/lobby/certificate_manager.py",
      "api_read": "GET /api/certificates",
      "api_actions": "POST /api/certificates/action",
      "authentication": "HTTPS + local session token + Origin/Host validation",
      "private_key_export": false,
      "manages_core_p2p_identity_certificate": false,
      "manages_lobby_loopback_tls": true,
      "manages_explicit_peer_trust": true
    },
    "bitcoin_identity": {
      "enabled": true,
      "module": "~/.node-core/lobby/bitcoin_identity.py",
      "api_read": "GET /api/identity/bitcoin",
      "challenge_endpoint": "POST /api/identity/bitcoin/challenge",
      "verify_endpoint": "POST /api/identity/bitcoin/verify",
      "cancel_endpoint": "POST /api/identity/bitcoin/cancel",
      "network": "mainnet",
      "address_type": "p2wpkh",
      "challenge_ttl_seconds": 300,
      "pending_ttl_seconds": 86400,
      "private_key_storage": false,
      "private_key_transmission": false,
      "proof": "single-use ECDSA challenge verified against compressed secp256k1 public key and derived P2WPKH address",
      "identity_assurance": "declared name plus proof of control of the supplied Bitcoin key; not civil-identity verification",
      "first_install_gate": "proof API is implemented; installer enforcement and browser-side private-key signing UI remain pending"
    }
  },
  "verification_required": [
    "official-installer-execution",
    "official-updater-execution",
    "persistent-identity-storage-preservation",
    "storage-and-kubo-ipfs-preservation",
    "updater-rollback",
    "server-start-stop",
    "https-browser-warning",
    "http-loopback-fallback",
    "widget-launch",
    "android-background-lifecycle",
    "browser-side-local-bitcoin-key-signing-ui",
    "first-install-bitcoin-identity-gate-enforcement",
    "lobby-bitcoin-identity-api-integration"
  ]
}
